  FAMILY
  GROUP
  CORPORATE
  AGENT
  RESELLER
  OTHER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  ARCHIVED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTATION
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum QuotationStatus {
  DRAFT
  READY
  SENT
  VIEWED
  NEGOTIATION
  ACCEPTED
  CONVERTED
  REJECTED
  EXPIRED
  CANCELLED
}

