  customerId    String                 @unique @map("customer_id") @db.Uuid
  email         String
  passwordHash  String                 @map("password_hash")
  active        Boolean                @default(true)
  lastLoginAt   DateTime?              @map("last_login_at")
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")
  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  customer      Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sessions      CustomerSession[]
  bookingClaims CustomerBookingClaim[]

  @@unique([tenantId, email])
  @@map("customer_accounts")
}

model CustomerBookingClaim {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  accountId  String          @map("account_id") @db.Uuid
  bookingId  String          @map("booking_id") @db.Uuid
  verifiedAt DateTime        @default(now()) @map("verified_at")
  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  account    CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  booking    Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([accountId, bookingId])
  @@index([tenantId, accountId, verifiedAt])
  @@index([tenantId, bookingId])
  @@map("customer_booking_claims")
}

model CustomerSession {
  id        String          @id @default(uuid()) @db.Uuid
  accountId String          @map("account_id") @db.Uuid
  tokenHash String          @unique @map("token_hash")
  expiresAt DateTime        @map("expires_at")
  createdAt DateTime        @default(now()) @map("created_at")
  account   CustomerAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@map("customer_sessions")
}
