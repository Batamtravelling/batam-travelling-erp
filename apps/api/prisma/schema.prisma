enum SurchargeBasis {
  PER_PAX
  PER_BOOKING
}

model Tenant {
  id                    String                 @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String                 @unique
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  users                 User[]
  customers             Customer[]
  leads                 Lead[]
  quotations            Quotation[]
  quotationItems        QuotationItem[]
  quotationVersions     QuotationVersion[]
  followUps             FollowUp[]
  audits                AuditLog[]
  outbox                OutboxEvent[]
  taskParticipants      TaskParticipant[]
  taskComments          TaskComment[]
  bookingPassengers     BookingPassenger[]
  packages              TravelPackage[]
  packageComponents     PackageComponent[]
  packageItineraries    PackageItinerary[]
  packageGallery        PackageGallery[]
  packageDepartures     PackageDeparture[]
  employeeContracts     EmployeeContract[]
  employeeDocuments     EmployeeDocument[]
  departureAssignments  DepartureAssignment[]
  employeeReminders     EmployeeReminder[]
  fileArchives          FileArchive[]
  articles              Article[]
  promotions            Promotion[]
  customerAccounts      CustomerAccount[]
  customerBookingClaims CustomerBookingClaim[]
  teamAssets            TeamAsset[]
  knowledgeDocuments    KnowledgeDocument[]
  knowledgeRevisions    KnowledgeRevision[]
  companyProfile        CompanyProfile?
  websiteMedia          WebsiteMediaFile[]
  vendors               Vendor[]
  vendorBills           VendorBill[]
  vendorLedger          VendorLedgerEntry[]
  financialEntries      FinancialEntry[]
  packageVendorRates    PackageVendorRate[]
  serviceProducts       ServiceProduct[]
  bookingItems          BookingItem[]
  projects              Project[]
  tasks                 Task[]
  milestones            ProjectMilestone[]
  monthlyTargets        ProjectMonthlyTarget[]
  bookings              Booking[]
  invoices              Invoice[]
  payments              Payment[]
  paymentProofs         PaymentProof[]
  paymentRefunds        PaymentRefund[]
  refundPolicy          TenantRefundPolicy?
  trips                 Trip[]
  assignments           TripAssignment[]
  businessSequences     BusinessSequence[]
  idempotencyRecords    IdempotencyRecord[]
  publicAccessAttempts  PublicAccessAttempt[]

  @@map("tenants")
}

model BusinessSequence {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  scope     String
  value     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, scope])
  @@map("business_sequences")
}

model IdempotencyRecord {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  operation   String
  key         String
  requestHash String   @map("request_hash")
  response    Json?
  statusCode  Int?     @map("status_code")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model PublicAccessAttempt {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  fingerprint     String
  attemptCount    Int      @default(1) @map("attempt_count")
  windowStartedAt DateTime @default(now()) @map("window_started_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, fingerprint])
  @@index([windowStartedAt])
  @@map("public_access_attempts")
}

model TravelPackage {
  id                   String              @id @default(uuid()) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  packageCode          String              @map("package_code")
  name                 String
  category             String?
  kind                 PackageKind         @default(REGULAR)
  destination          String?
  visitedDestinations  String?             @map("visited_destinations")
  durationDays         Int?                @map("duration_days")
  description          String?
  publicDescription    String?             @map("public_description")
  internalNotes        String?             @map("internal_notes")
  highlights           String?
  included             String?
  excluded             String?
  meetingPoint         String?             @map("meeting_point")
  importantInfo        String?             @map("important_info")
  optionalRequirements String?             @map("optional_requirements")
  serviceLevel         String              @default("REGULAR") @map("service_level")
  adultPrice           Decimal?            @map("adult_price") @db.Decimal(18, 2)
  childPrice           Decimal?            @map("child_price") @db.Decimal(18, 2)
  infantPrice          Decimal?            @map("infant_price") @db.Decimal(18, 2)
  childAgePolicy       String?             @map("child_age_policy")
  infantAgePolicy      String?             @map("infant_age_policy")
  packageDifferences   String?             @map("package_differences")
  promotionalLabel     String?             @map("promotional_label")
  originalPrice        Decimal?            @map("original_price") @db.Decimal(18, 2)
  specialPrice         Decimal?            @map("special_price") @db.Decimal(18, 2)
  specialPriceEndsAt   DateTime?           @map("special_price_ends_at")
  minPax               Int                 @default(1) @map("min_pax")
  maxPax               Int?                @map("max_pax")
  customizable         Boolean             @default(false)
  status               PackageStatus       @default(DRAFT)
  approvalStatus       ApprovalStatus      @default(DRAFT) @map("approval_status")
  submittedById        String?             @map("submitted_by_id") @db.Uuid
  submittedAt          DateTime?           @map("submitted_at")
  reviewedById         String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt           DateTime?           @map("reviewed_at")
  reviewNote           String?             @map("review_note")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  archivedAt           DateTime?           @map("archived_at")
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  submittedBy          User?               @relation("PackageSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  reviewedBy           User?               @relation("PackageReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  prices               PackagePrice[]
  bookings             Booking[]
  quotations           Quotation[]
  components           PackageComponent[]
  itineraries          PackageItinerary[]
  gallery              PackageGallery[]
  departures           PackageDeparture[]
  articleLinks         ArticlePackage[]
  promotionLinks       PromotionPackage[]
  vendorRates          PackageVendorRate[]
  bookingPassengers    BookingPassenger[]

  @@unique([tenantId, packageCode])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, status, approvalStatus, archivedAt])
  @@map("packages")
}

model ServiceProduct {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  productCode    String          @map("product_code")
  name           String
  category       String
  description    String?
  imageUrl       String?         @map("image_url")
  price          Decimal         @db.Decimal(18, 2)
  cost           Decimal?        @db.Decimal(18, 2)
  unit           String          @default("pax")
  capacity       Int?
  duration       String?
  route          String?
  meetingPoint   String?         @map("meeting_point")
  inclusions     String?
  importantInfo  String?         @map("important_info")
  availableDays  String?         @map("available_days")
  requiresDate   Boolean         @default(true) @map("requires_date")
  featured       Boolean         @default(false)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  bookingItems   BookingItem[]
  quotationItems QuotationItem[]

  @@unique([tenantId, productCode])
  @@index([tenantId, category, active])
  @@map("service_products")
}

model PackageComponent {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @map("tenant_id") @db.Uuid
  packageId     String               @map("package_id") @db.Uuid
  type          PackageComponentType
  name          String
  provider      String?
  quantity      Decimal              @default(1) @db.Decimal(12, 2)
  unit          String?
  cost          Decimal?             @db.Decimal(18, 2)
  sellingPrice  Decimal?             @map("selling_price") @db.Decimal(18, 2)
  notes         String?
  publicNotes   String?              @map("public_notes")
  internalNotes String?              @map("internal_notes")
  included      Boolean              @default(true)
  sortOrder     Int                  @default(0) @map("sort_order")
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  package       TravelPackage        @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([tenantId, packageId, sortOrder])
  @@map("package_components")
}

model PackageItinerary {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  packageId     String        @map("package_id") @db.Uuid
  dayNumber     Int           @map("day_number")
  time          String?
  title         String
  location      String?
  description   String?
  duration      String?
  notes         String?
  publicNotes   String?       @map("public_notes")
  internalNotes String?       @map("internal_notes")
  included      Boolean       @default(true)
  sortOrder     Int           @default(0) @map("sort_order")
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  package       TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([tenantId, packageId, dayNumber, sortOrder])
  @@map("package_itineraries")
}

model PackageGallery {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  packageId String        @map("package_id") @db.Uuid
  imageUrl  String        @map("image_url")
  caption   String?
  sortOrder Int           @default(0) @map("sort_order")
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  package   TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([tenantId, packageId, sortOrder])
  @@map("package_gallery")
}

model PackageDeparture {
  id              String                @id @default(uuid()) @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  packageId       String                @map("package_id") @db.Uuid
  projectId       String?               @map("project_id") @db.Uuid
  startsAt        DateTime              @map("starts_at")
  endsAt          DateTime?             @map("ends_at")
  bookingOpenAt   DateTime?             @map("booking_open_at")
  bookingCloseAt  DateTime?             @map("booking_close_at")
  minPax          Int                   @default(1) @map("min_pax")
  maxPax          Int                   @map("max_pax")
  meetingPoint    String?               @map("meeting_point")
  notes           String?
  publicNotes     String?               @map("public_notes")
  internalNotes   String?               @map("internal_notes")
  surchargeLabel  String?               @map("surcharge_label")
  surchargeAmount Decimal               @default(0) @map("surcharge_amount") @db.Decimal(18, 2)
  surchargeBasis  SurchargeBasis        @default(PER_PAX) @map("surcharge_basis")
  status          DepartureStatus       @default(SCHEDULED)
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  package         TravelPackage         @relation(fields: [packageId], references: [id], onDelete: Cascade)
  project         Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  bookings        Booking[]
  assignments     DepartureAssignment[]
  tasks           Task[]
  reminders       EmployeeReminder[]

  @@index([tenantId, packageId, startsAt, status])
  @@map("package_departures")
}

model DepartureAssignment {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  departureId String           @map("departure_id") @db.Uuid
  employeeId  String           @map("employee_id") @db.Uuid
  role        AssignmentRole
  status      AssignmentStatus @default(ASSIGNED)
  taskNote    String?          @map("task_note")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departure   PackageDeparture @relation(fields: [departureId], references: [id], onDelete: Cascade)
  employee    User             @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([departureId, employeeId, role])
  @@index([tenantId, employeeId, status])
  @@map("departure_assignments")
}

model EmployeeReminder {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  employeeId  String            @map("employee_id") @db.Uuid
  departureId String?           @map("departure_id") @db.Uuid
  taskId      String?           @map("task_id") @db.Uuid
  title       String
  message     String?
  remindAt    DateTime          @map("remind_at")
  status      ReminderStatus    @default(PENDING)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  employee    User              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  departure   PackageDeparture? @relation(fields: [departureId], references: [id], onDelete: Cascade)
  task        Task?             @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId, status, remindAt])
  @@map("employee_reminders")
}

model PackagePrice {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @map("tenant_id") @db.Uuid
  packageId    String        @map("package_id") @db.Uuid
  type         PriceType
  cost         Decimal?      @db.Decimal(18, 2)
  sellingPrice Decimal       @map("selling_price") @db.Decimal(18, 2)
  paxFrom      Int?          @map("pax_from")
  paxTo        Int?          @map("pax_to")
  startsAt     DateTime?     @map("starts_at") @db.Date
  endsAt       DateTime?     @map("ends_at") @db.Date
  priority     Int           @default(0)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  package      TravelPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  @@index([tenantId, packageId, active, priority])
  @@map("package_prices")
}

model User {
  id                            String                @id @default(uuid()) @db.Uuid
  tenantId                      String                @map("tenant_id") @db.Uuid
  cognitoId                     String?               @unique @map("cognito_id")
  email                         String
  name                          String
  phone                         String?
  jobTitle                      String?               @map("job_title")
  employeeCode                  String?               @map("employee_code")
  photoUrl                      String?               @map("photo_url")
  skills                        String?
  availability                  String?
  active                        Boolean               @default(true)
  createdAt                     DateTime              @default(now()) @map("created_at")
  updatedAt                     DateTime              @updatedAt @map("updated_at")
  tenant                        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  roles                         UserRole[]
  ownedProjects                 Project[]             @relation("ProjectOwner")
  assignedTasks                 Task[]                @relation("TaskAssignee")
  taskParticipants              TaskParticipant[]
  taskComments                  TaskComment[]
  receivedPayments              Payment[]             @relation("PaymentReceiver")
  verifiedPayments              Payment[]             @relation("PaymentVerifier")
  tripAssignments               TripAssignment[]
  assignedFollowUps             FollowUp[]
  contracts                     EmployeeContract[]
  documents                     EmployeeDocument[]
  departureAssignments          DepartureAssignment[]
  reminders                     EmployeeReminder[]
  uploadedArchives              FileArchive[]
  authoredArticles              Article[]
  submittedPackages             TravelPackage[]       @relation("PackageSubmitter")
  reviewedPackages              TravelPackage[]       @relation("PackageReviewer")
  submittedPromotions           Promotion[]           @relation("PromotionSubmitter")
  reviewedPromotions            Promotion[]           @relation("PromotionReviewer")
  assignedAssets                TeamAsset[]           @relation("AssetAssignee")
  ownedKnowledge                KnowledgeDocument[]   @relation("KnowledgeOwner")
  revisedKnowledge              KnowledgeDocument[]   @relation("KnowledgeReviser")
  knowledgeRevisions            KnowledgeRevision[]
  revisedCompanyProfiles        CompanyProfile[]
  uploadedWebsiteMedia          WebsiteMediaFile[]
  managedVendors                Vendor[]              @relation("VendorPic")
  recordedVendorLedger          VendorLedgerEntry[]
  recordedFinancialEntries      FinancialEntry[]      @relation("FinancialEntryRecordedBy")
  reversedFinancialEntries      FinancialEntry[]      @relation("FinancialEntryReversedBy")
  uploadedPaymentProofs         PaymentProof[]
  processedPaymentRefunds       PaymentRefund[]
  requestedPaymentRefunds       PaymentRefund[]       @relation("RefundRequester")
  managerApprovedPaymentRefunds PaymentRefund[]       @relation("RefundManagerApprover")
  ownerApprovedPaymentRefunds   PaymentRefund[]       @relation("RefundOwnerApprover")
  rejectedPaymentRefunds        PaymentRefund[]       @relation("RefundRejector")
  createdQuotations             Quotation[]           @relation("QuotationCreator")
  sentQuotations                Quotation[]           @relation("QuotationSender")
  acceptedQuotations            Quotation[]           @relation("QuotationAcceptor")
  quotationVersions             QuotationVersion[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model TeamAsset {
  id             String      @id @default(uuid()) @db.Uuid
  tenantId       String      @map("tenant_id") @db.Uuid
  assetCode      String      @map("asset_code")
  name           String
  category       String
  brand          String?
  serialNumber   String?     @map("serial_number")
  status         AssetStatus @default(AVAILABLE)
  assignedToId   String?     @map("assigned_to_id") @db.Uuid
  location       String?
  purchaseDate   DateTime?   @map("purchase_date") @db.Date
  purchaseValue  Decimal?    @map("purchase_value") @db.Decimal(18, 2)
  warrantyUntil  DateTime?   @map("warranty_until") @db.Date
  notes          String?
  lastReviewedAt DateTime?   @map("last_reviewed_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignedTo     User?       @relation("AssetAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

