NODE_ENV=development
PORT=3000
# Vercel runtime: use the Supabase transaction pooler (port 6543) and keep
# connection_limit modest per function instance. Transaction mode must disable
# prepared statements (for Prisma, include pgbouncer=true).
DATABASE_URL="postgresql://batam_erp:batam_erp@localhost:5432/batam_erp?schema=public&connection_limit=10&pool_timeout=10"
# Prisma migrations/administration: Supabase direct or session pooler (port
# 5432), never the transaction pooler. Keep this server-only.
DIRECT_URL="postgresql://batam_erp:batam_erp@localhost:5432/batam_erp?schema=public"

# Browser/API routing
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
# Server-side origin used by SSR public pages. In production this must resolve
# from the web container/server to the API and must never be localhost.
SERVER_API_URL="http://localhost:3000/api/v1"
CORS_ORIGINS="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
RATE_LIMIT_MAX="300"
RATE_LIMIT_WINDOW="1 minute"
HOUSEKEEPING_INTERVAL_MS="3600000"
# Shared rate-limit store for multi-instance production. Required before scaling API replicas.
REDIS_URL=""
ENABLE_API_DOCS="false"

# Supabase Auth — publishable keys are safe for browser use; never put secret/service-role keys here.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"
# Server-only. Never use NEXT_PUBLIC_ for this value.
SUPABASE_SECRET_KEY="sb_secret_replace_me"
SUPABASE_MEDIA_BUCKET="erp-media"
# Private bucket; payment proofs must never use a public URL.
SUPABASE_PRIVATE_BUCKET="erp-private"
PUBLIC_TENANT_SLUG="batam-travelling"
ERP_OWNER_EMAIL="owner@batamtravelling.com"
ERP_OWNER_NAME="Kariadi"
# Aktifkan sementara hanya saat menghubungkan owner pertama, lalu matikan kembali.
ALLOW_AUTH_EMAIL_LINK="false"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Development-only identity fallback. Ignored by the browser and rejected by the API in production.
NEXT_PUBLIC_DEV_TENANT_ID=""
NEXT_PUBLIC_DEV_USER_ID=""
SEED_DEMO_DATA="false"

# Customer passwordless authentication. `local` is rejected in production.
CUSTOMER_AUTH_PROVIDER="local"
# Development/test only: returns OTP in the API response for local E2E automation.
CUSTOMER_AUTH_EXPOSE_LOCAL_OTP="false"
