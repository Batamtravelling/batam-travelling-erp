NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://batam_erp:batam_erp@localhost:5432/batam_erp?schema=public"

# Browser/API routing
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
CORS_ORIGINS="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
RATE_LIMIT_MAX="300"
RATE_LIMIT_WINDOW="1 minute"

# Supabase Auth — publishable keys are safe for browser use; never put secret/service-role keys here.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"
# Server-only. Never use NEXT_PUBLIC_ for this value.
SUPABASE_SECRET_KEY="sb_secret_replace_me"
SUPABASE_MEDIA_BUCKET="erp-media"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Development-only identity fallback. Ignored by the browser and rejected by the API in production.
NEXT_PUBLIC_DEV_TENANT_ID=""
NEXT_PUBLIC_DEV_USER_ID=""
