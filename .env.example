NODE_ENV=development
PORT=3000
# Runtime: use the Supabase transaction pooler and keep connection_limit modest
# per API instance. For migrations, temporarily provide the Supabase direct or
# session-pooler connection as DATABASE_URL (never the transaction pooler).
DATABASE_URL="postgresql://batam_erp:batam_erp@localhost:5432/batam_erp?schema=public&connection_limit=10&pool_timeout=10"

# Browser/API routing
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
CORS_ORIGINS="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
RATE_LIMIT_MAX="300"
RATE_LIMIT_WINDOW="1 minute"
# Shared rate-limit store for multi-instance production. Required before scaling API replicas.
REDIS_URL=""
ENABLE_API_DOCS="false"

# Supabase Auth — publishable keys are safe for browser use; never put secret/service-role keys here.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"
# Server-only. Never use NEXT_PUBLIC_ for this value.
SUPABASE_SECRET_KEY="sb_secret_replace_me"
SUPABASE_MEDIA_BUCKET="erp-media"
ERP_OWNER_EMAIL="owner@batamtravelling.com"
ERP_OWNER_NAME="Kariadi"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace_me"

# Development-only identity fallback. Ignored by the browser and rejected by the API in production.
NEXT_PUBLIC_DEV_TENANT_ID=""
NEXT_PUBLIC_DEV_USER_ID=""
