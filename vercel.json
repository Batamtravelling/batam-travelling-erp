{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/docs/:path*",
      "destination": "/api"
    },
    {
      "source": "/docs",
      "destination": "/api"
    }
  ]
}
